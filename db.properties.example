# TechShop Manager - configuration de la base de données
# Copier ce fichier dans config/db.properties à côté de TechShopManager.exe
# puis adapter l'hôte, le port, le nom de la base et les identifiants.

db.host=localhost
db.port=3306
db.name=techshop
db.user=root
db.password=

# --- Pool de connexions HikariCP ---
db.pool.size=10
db.pool.minIdle=2
db.pool.timeoutMs=30000