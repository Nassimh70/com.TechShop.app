<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.RepairsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Atelier — Réparations"/>
            <Label styleClass="muted" text="Dépôt, diagnostic, pièces, main d'œuvre et remise de l'appareil"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT"/>
    </HBox>

    <HBox styleClass="filters-bar" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" styleClass="field" promptText="Rechercher (N°, client, IMEI, modèle…)"/>
        <ComboBox fx:id="statusFilter" styleClass="field"/>
        <ComboBox fx:id="techFilter" styleClass="field"/>
        <javafx.scene.control.CheckBox fx:id="lateFilter" styleClass="check" text="En retard uniquement"/>
        <Region HBox.hgrow="ALWAYS"/>
        <javafx.scene.control.ToggleButton fx:id="kanbanToggle" styleClass="segmented" text="Kanban"/>
        <javafx.scene.control.ToggleButton fx:id="tableToggle" styleClass="segmented" text="Tableau"/>
    </HBox>

    <StackPane fx:id="root" VBox.vgrow="ALWAYS"/>
</VBox>
