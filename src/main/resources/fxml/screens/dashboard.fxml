<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.DashboardController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Tableau de bord"/>
            <Label styleClass="muted" text="Synthèse du jour, stock, caisse et ventes récentes"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT"/>
    </HBox>

    <!-- Le corps défile : le tableau de bord est plus haut que la fenêtre. -->
    <ScrollPane styleClass="page-scroll" fitToWidth="true" hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="12">
                <FlowPane fx:id="statsPane" hgap="12" vgap="12"/>
                <HBox spacing="12">
                    <VBox fx:id="leftPane" spacing="12" HBox.hgrow="ALWAYS"/>
                    <VBox fx:id="rightPane" spacing="12" minWidth="360" prefWidth="380"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
