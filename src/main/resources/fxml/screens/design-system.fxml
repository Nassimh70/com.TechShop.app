<?xml version="1.0" encoding="UTF-8"?>
<!-- Page « Design system » : vitrine de tous les composants dans le thème courant. -->
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<ScrollPane fitToWidth="true" fitToHeight="false" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.techshop.controller.DesignSystemController">
    <content>
        <VBox fx:id="content" styleClass="page-pane" spacing="8"/>
    </content>
</ScrollPane>
