<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.techshop.controller.SetupController">
    <HBox styleClass="auth-split">
        <VBox styleClass="auth-brand" HBox.hgrow="ALWAYS">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="brandIcon" styleClass="logo-badge"/>
                <VBox spacing="1">
                    <Label styleClass="app-name" text="TechShop Manager"/>
                    <Label styleClass="app-sub" text="PREMIÈRE CONFIGURATION"/>
                </VBox>
            </HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label styleClass="auth-headline" text="Configurez votre magasin hors ligne."
                   wrapText="true"/>
            <Label styleClass="auth-brand-foot"
                   text="Aucun compte ou mot de passe prédéfini"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox styleClass="auth-form-side">
            <VBox styleClass="auth-card" maxWidth="520.0">
                <Label styleClass="auth-title" text="Assistant de configuration"/>
                <Label styleClass="auth-sub"
                       text="Les informations restent sur cet ordinateur."
                       wrapText="true"/>
                <VBox fx:id="formBox" spacing="12"/>
                <Label fx:id="errorLabel" styleClass="auth-error" wrapText="true"
                       managed="false" visible="false"/>
            </VBox>
        </VBox>
    </HBox>
    <StackPane fx:id="overlayHost" mouseTransparent="true"/>
</StackPane>
