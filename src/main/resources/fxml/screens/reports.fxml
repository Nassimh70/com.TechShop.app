<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.ReportsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Rapports"/>
            <Label styleClass="muted" text="Analyse des ventes, achats, stock, SAV et finances"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT">
            <DatePicker fx:id="dpFrom" promptText="Du"/>
            <DatePicker fx:id="dpTo" promptText="Au"/>
            <Button fx:id="btnRefresh" onAction="#onRefresh" text="Actualiser" styleClass="btn-primary"/>
            <Button fx:id="btnPdf" onAction="#onExportPdf" text="Export PDF"/>
            <Button fx:id="btnExcel" onAction="#onExportExcel" text="Export Excel"/>
            <Button fx:id="btnPrint" onAction="#onPrint" text="Imprimer"/>
        </HBox>
    </HBox>

    <VBox fx:id="root" spacing="12" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Rapport :"/>
            <ComboBox fx:id="cbReport" prefWidth="320"/>
        </HBox>
        <TabPane fx:id="tabs" VBox.vgrow="ALWAYS">
            <Tab text="Tableau" closable="false">
                <VBox spacing="8">
                    <TableView fx:id="table" styleClass="data-table" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
            <Tab text="Graphiques" closable="false">
                <VBox fx:id="chartPane" spacing="8"/>
            </Tab>
        </TabPane>
    </VBox>
</VBox>