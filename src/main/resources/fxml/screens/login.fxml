<?xml version="1.0" encoding="UTF-8"?>
<!--
  TechShop Manager - écran de connexion (SPEC §4.1).
  Écran scindé : présentation de la marque à gauche, formulaire à droite.
-->
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.techshop.controller.LoginController">

    <HBox styleClass="auth-split">
        <!-- ============================ Marque (gauche) ============================ -->
        <VBox styleClass="auth-brand" HBox.hgrow="ALWAYS">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="brandIcon" styleClass="logo-badge"/>
                <VBox spacing="1">
                    <Label styleClass="app-name" text="TechShop Manager"/>
                    <Label styleClass="app-sub" text="GESTION COMMERCIALE"/>
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label styleClass="auth-headline" text="La gestion du magasin, simplement." wrapText="true"/>
            <VBox fx:id="brandFeatures" styleClass="auth-features" spacing="12"/>
            <Label styleClass="auth-brand-foot" text="Boutique de téléphonie · Alger"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- ========================== Formulaire (droite) ========================= -->
        <VBox styleClass="auth-form-side">
            <VBox styleClass="auth-card" maxWidth="400.0" maxHeight="-Infinity" minHeight="-Infinity">
                <Label styleClass="auth-title" text="Connexion"/>
                <Label styleClass="auth-sub" text="Accédez à votre espace de gestion"
                       wrapText="true"/>
                <VBox fx:id="formBox" spacing="16"/>
                <Label fx:id="errorLabel" styleClass="auth-error" wrapText="true"
                       managed="false" visible="false"/>
                <Region prefHeight="2"/>
            </VBox>
            <Label styleClass="auth-footer" text="TechShop Manager · v1.0"/>
        </VBox>
    </HBox>

    <!-- Calque des toasts et dialogues de l'écran -->
    <StackPane fx:id="overlayHost" mouseTransparent="true"/>
</StackPane>
