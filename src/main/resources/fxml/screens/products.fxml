<?xml version="1.0" encoding="UTF-8"?>
<!--
  TechShop Manager - module Produits (SPEC §4.5, §6.1).
  Catalogue : recherche, filtres, pagination, vue tableau/grille, actions par
  ligne, import CSV, gestion des catégories et marques, étiquettes code-barres.
  Le corps de l'écran est construit par le contrôleur (comme le module
  Utilisateurs) pour rester cohérent avec le design system.
-->
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.ProductsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Produits"/>
            <Label styleClass="muted" text="Catalogue, prix, codes-barres et disponibilité"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT"/>
    </HBox>

    <VBox fx:id="root" spacing="12" VBox.vgrow="ALWAYS"/>
</VBox>
