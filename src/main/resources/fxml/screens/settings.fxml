<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.SettingsController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Paramètres"/>
            <Label styleClass="muted" text="Magasin, documents, apparence et sauvegarde"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEtat" styleClass="muted"/>
        <Button fx:id="btnSave" onAction="#onSave" text="Enregistrer" styleClass="btn,btn-primary"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox fx:id="nav" styleClass="card,settings-nav" spacing="4"
              prefWidth="230" minWidth="210" maxWidth="260"/>
        <ScrollPane fx:id="scroll" styleClass="page-scroll" fitToWidth="true"
                    hbarPolicy="NEVER" HBox.hgrow="ALWAYS">
            <VBox fx:id="contenu" styleClass="settings-content" spacing="16"/>
        </ScrollPane>
    </HBox>
</VBox>
