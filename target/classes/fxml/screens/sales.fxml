<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.SalesController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Ventes"/>
            <Label styleClass="muted" text="Historique, filtres, détail, réimpression et retours"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="headerActions" spacing="8" alignment="CENTER_RIGHT"/>
    </HBox>

    <HBox styleClass="filters-bar" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" styleClass="field" promptText="Rechercher (N°, client, vendeur...)"/>
        <DatePicker fx:id="fromDate" styleClass="field"/>
        <DatePicker fx:id="toDate" styleClass="field"/>
        <ComboBox fx:id="statutFilter" styleClass="field"/>
    </HBox>

    <VBox fx:id="root" spacing="12" VBox.vgrow="ALWAYS"/>
</VBox>
