<?xml version="1.0" encoding="UTF-8"?>
<!--
  TechShop Manager - module Utilisateurs (SPEC §3, §4.12, §6).
  Trois onglets : comptes, matrice de permissions, journal d'activité.
-->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="page-pane" spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techshop.controller.UsersController">

    <HBox styleClass="page-header">
        <VBox spacing="2">
            <Label styleClass="section-title" text="Utilisateurs &amp; sécurité"/>
            <Label styleClass="muted" text="Comptes, rôles, permissions et journal d'activité"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newUserBtn" styleClass="btn,btn-primary" text="Nouvel utilisateur"/>
    </HBox>

    <TabPane fx:id="tabs" styleClass="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Utilisateurs">
                <content>
                    <VBox fx:id="usersTab" spacing="12"/>
                </content>
            </Tab>
            <Tab text="Permissions">
                <content>
                    <VBox fx:id="permsTab" spacing="12"/>
                </content>
            </Tab>
            <Tab text="Journal d'activité">
                <content>
                    <VBox fx:id="journalTab" spacing="12"/>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
