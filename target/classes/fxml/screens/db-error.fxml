<?xml version="1.0" encoding="UTF-8"?>
<!--
  TechShop Manager - écran d'erreur de connexion à la base (SPEC §5, §7).
  Message clair + « Réessayer » + accès aux réglages de connexion.
-->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane styleClass="app-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.techshop.controller.DbErrorController">

    <VBox styleClass="conn-card" alignment="CENTER" maxWidth="640">
        <StackPane fx:id="errorIcon" styleClass="conn-icon"/>
        <Label styleClass="conn-title" text="Base de données indisponible"/>
        <Label fx:id="messageLabel" styleClass="conn-msg" wrapText="true" maxWidth="560"/>
        <Label fx:id="attemptsLabel" styleClass="conn-hint" wrapText="true" maxWidth="560"/>
        <Label styleClass="conn-hint" wrapText="true" maxWidth="560"
               text="Si vous utilisez XAMPP, démarrez le module « MySQL » depuis le panneau de contrôle, puis réessayez."/>
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="retryBtn" styleClass="btn,btn-primary" text="Réessayer"/>
            <Button fx:id="settingsBtn" styleClass="btn,btn-outline"
                    text="Réglages de connexion"/>
        </HBox>
    </VBox>

    <StackPane fx:id="overlayHost"/>
</StackPane>
