<?xml version="1.0" encoding="UTF-8"?>
<!--
  TechShop Manager - Gestion commerciale pour magasin de téléphones / accessoires / outils informatiques.
  Java 21 + JavaFX 21 + SQLite (Xerial) - JDBC pur avec HikariCP.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.techshop</groupId>
    <artifactId>techshop-manager</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>TechShop Manager</name>
    <description>Application de gestion commerciale : stock, caisse (POS) et SAV.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <!-- Plateforme des modules JavaFX (win / linux / mac / mac-aarch64) -->
        <javafx.platform>win</javafx.platform>
        <hikaricp.version>5.1.0</hikaricp.version>
        <sqlite.version>3.54.1.0</sqlite.version>
        <!-- Uniquement pour l'outil ponctuel de migration (profil mysql-migration) -->
        <mariadb.version>3.3.3</mariadb.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <junit.version>5.10.2</junit.version>
        <main.class>com.techshop.app.Launcher</main.class>
        <!-- APP_IMAGE : dossier portable avec "TechShop Manager.exe" (sans WiX).
             Pour un installateur EXE/MSI (WiX requis), utiliser le profil
             "installer" : mvn -Pjpackage,installer verify
             (ou -Djpackage.type=MSI avec le même profil). -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <!-- Options spécifiques aux installateurs Windows. Elles doivent rester
             désactivées pour APP_IMAGE, sinon jpackage refuse l'option. -->
        <jpackage.winShortcut>false</jpackage.winShortcut>
        <jpackage.winMenu>false</jpackage.winMenu>
        <jpackage.winDirChooser>false</jpackage.winDirChooser>
        <jpackage.winUpgradeUuid></jpackage.winUpgradeUuid>
    </properties>

    <!-- licence-core est fourni dans lib/repo : le projet se construit sans
         dépendre d'un dépôt interne. Le jar ne contient que la vérification
         par clé publique (aucune clé privée, aucun code de signature). -->
    <repositories>
        <repository>
            <id>techshop-vendored</id>
            <name>TechShop vendored dependencies</name>
            <url>file:///${project.basedir}/lib/repo</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Vérification de licence hors ligne (clé publique uniquement) -->
        <dependency>
            <groupId>dev.techshop</groupId>
            <artifactId>license-core</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ============ JavaFX (controls, fxml, graphiques pour les courbes/anneaux) ============ -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- Remarque : javafx.scene.chart (courbes, anneaux) est inclus dans
             le module javafx.controls — aucun artefact « javafx-charts » séparé. -->

        <!-- ============ Base de données : SQLite embarqué (aucun serveur requis) ============ -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <!-- Pool de connexions JDBC -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>

        <!-- ============ Sécurité : hachage des mots de passe ============ -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ============ Icônes Feather via Ikonli ============ -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>12.3.1</version>
        </dependency>

        <!-- ============ Export PDF (tickets 80 mm, factures A4, rapports) ============ -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.43</version>
        </dependency>

        <!-- ============ Export Excel (rapports) ============ -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ============ Codes-barres (étiquettes, tickets) ============ -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- ============ Logs ============ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ============ Tests ============ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Lancement : mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <!-- Projet non modulaire (classpath) : JavaFX 21 le supporte avec un simple avertissement -->
                    <options>
                        <option>--add-opens</option>
                        <option>java.base/java.lang=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Migration ponctuelle MySQL/MariaDB vers SQLite. Le pilote MariaDB n'est
          présent que dans ce profil : il n'est jamais embarqué dans
          l'installateur client.
          Voir la section « Migration depuis MySQL/MariaDB » du README pour la
          commande complète et les options source-url, source-user,
          source-password et target.
        -->
        <profile>
            <id>mysql-migration</id>
            <dependencies>
                <dependency>
                    <groupId>org.mariadb.jdbc</groupId>
                    <artifactId>mariadb-java-client</artifactId>
                    <version>${mariadb.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <mainClass>com.techshop.tools.MySqlToSqliteMigrator</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Packaging Windows : mvn -Pjpackage verify
             Produit une image applicative autonome (target/dist) sans WiX.
             Nécessite un JDK complet (pas seulement JRE) avec jpackage disponible. -->
        <profile>
            <id>jpackage</id>
            <build>
                <plugins>
                    <!-- Copie des dépendances pour jpackage (application classpath) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>copy-deps</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/deps</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Copie du jar principal à côté des dépendances -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-main-jar</id>
                                <phase>verify</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/deps</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes><include>${project.build.finalName}.jar</include></includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <configuration>
                            <name>TechShop Manager</name>
                            <vendor>TechShop</vendor>
                            <description>Gestion commerciale TechShop Manager</description>
                            <copyright>© 2026 TechShop</copyright>
                            <appVersion>1.0.0</appVersion>
                            <type>${jpackage.type}</type>
                            <icon>${project.basedir}/src/main/resources/images/brand/techshop.ico</icon>
                            <input>${project.build.directory}/deps</input>
                            <destination>${project.build.directory}/dist</destination>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>${main.class}</mainClass>
                            <!-- Raccourcis et désinstalleur Windows (uniquement EXE/MSI) -->
                            <winShortcut>${jpackage.winShortcut}</winShortcut>
                            <winMenu>${jpackage.winMenu}</winMenu>
                            <winDirChooser>${jpackage.winDirChooser}</winDirChooser>
                            <winUpgradeUuid>${jpackage.winUpgradeUuid}</winUpgradeUuid>
                            <!-- Les données restent dans %APPDATA% : une mise à jour ne les supprime pas. -->
                            <!-- Options JavaFX / encodage / ouverture de modules (classpath) -->
                            <javaOptions>
                                <option>--add-opens</option>
                                <option>java.base/java.lang=ALL-UNNAMED</option>
                                <option>-Dfile.encoding=UTF-8</option>
                                <option>-Dtechshop.profile=prod</option>
                            </javaOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals><goal>jpackage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Installateur Windows (EXE par défaut, MSI via -Djpackage.type=MSI).
             Prérequis : WiX Toolset 3.x installé (candle.exe / light.exe dans le PATH).
             Les données restent dans %APPDATA%\TechShopManager : désinstaller ou
             mettre à jour l'application ne supprime pas la base du client. -->
        <profile>
            <id>installer</id>
            <properties>
                <jpackage.type>EXE</jpackage.type>
                <jpackage.winShortcut>true</jpackage.winShortcut>
                <jpackage.winMenu>true</jpackage.winMenu>
                <jpackage.winDirChooser>true</jpackage.winDirChooser>
                <jpackage.winUpgradeUuid>7c8f2f1e-9a2b-4a6e-8f3c-1d2e3f4a5b6c</jpackage.winUpgradeUuid>
            </properties>
        </profile>
    </profiles>
</project>
